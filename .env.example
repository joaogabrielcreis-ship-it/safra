# Token da integração interna do Notion (notion.so/profile/integrations)
NOTION_TOKEN=ntn_xxx
# Senha que o app pede no celular. Use algo longo.
CELLAR_PIN=troque-esta-senha
# Opcional: IDs das data sources (os padrões já são as suas bases Cellar e Travel Plans)
# CELLAR_DATA_SOURCE=be11237b-05a7-4986-9172-19dfe5aa1fa0
# TRIPS_DATA_SOURCE=3dad968c-1a42-43f1-9700-c7d20eb7b693
